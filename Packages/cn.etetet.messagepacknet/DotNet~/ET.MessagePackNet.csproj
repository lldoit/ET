<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ET</RootNamespace>
    <LangVersion>default</LangVersion>
    <AssemblyName>ET.MessagePackNet</AssemblyName>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DOTNET;ET10</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\Bin</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>DOTNET;ET10</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\Bin</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Runtime\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\cn.etetet.core\DotNet~\ET.Core.csproj" />
    <ProjectReference Include="..\..\cn.etetet.messagepack\DotNet~\MessagePack.csproj" />
    <ProjectReference Include="..\..\cn.etetet.messagepack\DotNet~\MessagePack.Annotations.csproj" />
  </ItemGroup>
</Project>
